# Image of the four fake MCP servers used to test D1. Built by `mcp-audit lab build`.
# The base image is pinned by the digest of its multi-platform index (amd64 and arm64).
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
COPY lab.js /opt/mcp-audit/lab.js
COPY fake-server.js /opt/mcp-audit/fake-server.js
USER 1000:1000
CMD ["sleep", "infinity"]
