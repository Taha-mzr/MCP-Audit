# Image of one version of @modelcontextprotocol/server-filesystem, built by `mcp-audit lab build`.
# The network is used only here, to install the package; the test runs with --network none.
# Every dependency is pinned with its integrity hash by the package-lock.json of that version,
# and installed with `npm ci`, which fails if the lock file and package.json disagree.
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ARG VERSION
WORKDIR /opt/server
COPY server-filesystem-${VERSION}/package.json server-filesystem-${VERSION}/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY lab.js /opt/mcp-audit/lab.js
USER 1000:1000
CMD ["sleep", "infinity"]
